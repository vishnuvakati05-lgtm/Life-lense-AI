# LifeLens AI Environment Configuration

# Flask Application
SECRET_KEY=your-random-secret-key-here
FLASK_ENV=development
PORT=5000

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Tesseract OCR Executable (Auto-detected if installed at default system path)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Optional LLM API Keys (LifeLens works 100% locally & offline without these!)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Open Food Facts API
OPEN_FOOD_FACTS_URL=https://world.openfoodfacts.org/api/v2/product

